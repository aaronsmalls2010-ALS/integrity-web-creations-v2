---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RecurrenceFields from '../../../components/admin/RecurrenceFields.astro';
import { listClients } from '../../../lib/db/clients';
import { getSettings } from '../../../lib/db/settings';
const clients = await listClients(Astro.cookies);
const settings: any = await getSettings(Astro.cookies).catch(() => null);
---
<AdminLayout title="New Recurring Schedule">
  <h1 class="text-2xl font-bold text-[#e6edf5]">New recurring schedule</h1>
  <form id="f" class="mt-6 max-w-3xl space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="lbl" for="client_id">Client *</label>
        <select id="client_id" name="client_id" required class="input">
          <option value="">Select client…</option>
          {clients.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div>
        <label class="lbl" for="name">Schedule name *</label>
        <input id="name" name="name" placeholder="e.g. Monthly Hosting" required class="input" />
      </div>
      <div class="sm:col-span-2 flex items-end pb-1">
        <label class="flex items-center gap-2 text-sm text-[#9fb3c8] cursor-pointer">
          <input type="checkbox" name="auto_send" class="rounded" /> Auto-send: issue and email the invoice automatically (otherwise it's created as a draft for review)
        </label>
      </div>
    </div>
    <RecurrenceFields defaultDueDays={settings?.default_due_days ?? 14} />
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-[#9fb3c8]">
          <th>Description</th>
          <th class="w-20">Qty</th>
          <th class="w-28">Unit $</th>
          <th class="w-12">Tax</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="lines"></tbody>
    </table>
    <button type="button" id="addLine" class="btn-ghost text-sm px-3 py-1">+ Line</button>
    <p id="err" class="hidden text-sm text-[#ff6b6b]" role="alert"></p>
    <button type="submit" class="btn-primary">Save schedule</button>
  </form>
  <script>
    import { dollarsToCents } from '../../../lib/money';
    import { initRecurrenceFields, readScheduleFields, validateSelection } from '../../../lib/recurrence-form';
    initRecurrenceFields();
    const linesEl = document.getElementById('lines')!;
    function addRow(desc = '', price = '', tax = false, qty = 1) {
      const tr = document.createElement('tr');
      tr.className = 'border-t border-white/10';
      tr.innerHTML = `<td><input class="desc w-full rounded border p-1" value="${desc.replace(/"/g, '&quot;')}"/></td><td><input class="qty w-full rounded border p-1" type="number" step="0.01" value="${qty}"/></td><td><input class="unit w-full rounded border p-1" value="${price}"/></td><td class="text-center"><input class="tax" type="checkbox" ${tax ? 'checked' : ''}/></td><td><button type="button" class="rm text-red-600">×</button></td>`;
      linesEl.appendChild(tr);
      tr.querySelector('.rm')!.addEventListener('click', () => tr.remove());
    }
    document.getElementById('addLine')!.addEventListener('click', () => addRow());
    addRow();
    document.getElementById('f')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector('button[type=submit],button:not([type])') as HTMLButtonElement;
      const prevText = btn.textContent!;
      btn.disabled = true; btn.textContent = 'Saving…';
      const line_items = Array.from(linesEl.querySelectorAll('tr')).map((tr) => ({
        description: (tr.querySelector('.desc') as HTMLInputElement).value,
        quantity: Number((tr.querySelector('.qty') as HTMLInputElement).value || '0'),
        unit_price_cents: (() => { try { return dollarsToCents((tr.querySelector('.unit') as HTMLInputElement).value || '0'); } catch { return 0; } })(),
        taxable: (tr.querySelector('.tax') as HTMLInputElement).checked,
      })).filter((l) => l.description.trim() !== '');
      const err = document.getElementById('err')!;
      const fail = (msg: string) => { err.textContent = msg; err.classList.remove('hidden'); btn.disabled = false; btn.textContent = prevText; };
      if (line_items.length === 0) return fail('Add at least one line item.');
      const scheduleProblem = validateSelection();
      if (scheduleProblem) return fail(scheduleProblem);
      const body = {
        client_id: (form.elements.namedItem('client_id') as HTMLSelectElement).value,
        name: (form.elements.namedItem('name') as HTMLInputElement).value,
        ...readScheduleFields(),
        auto_send: (form.elements.namedItem('auto_send') as HTMLInputElement).checked,
        active: true,
        line_items,
      };
      const res = await fetch('/api/admin/recurring', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const j = await res.json();
      if (res.ok) window.location.href = '/admin/recurring';
      else fail(j.error ?? 'Could not save the schedule.');
    });
  </script>
</AdminLayout>
